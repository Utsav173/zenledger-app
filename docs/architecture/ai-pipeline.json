  "cards": [
    {
      "dot": "emerald",
      "title": "Air-Gapped Ingestion",
      "items": [
        "PDF text and camera OCR streams are normalized locally in memory",
        "LayoutAnalyzer separates transactional tables from headers and marketing noise",
        "No unencrypted file buffers are written to shared system storage"
      ]
    },
    {
      "dot": "cyan",
      "title": "LiteRT Gemma 2B Neural Core",
      "items": [
        "Runs on device hardware NPU or quantized CPU threads with zero network sockets",
        "StructuredPrompt ensures output adheres to strict JSON row contracts",
        "Fallbacks to user-provided OpenRouter/Gemini keys are strictly opt-in"
      ]
    },
    {
      "dot": "orange",
      "title": "LedgerPathFinder DAG Solver",
      "items": [
        "Solves Weighted Longest Path Dynamic Programming over scrambled statement rows",
        "Auto-detects forward vs reverse chronological sorting",
        "Enforces closing balance = opening balance ± sum(delta) invariant before saving"
      ]
    }
  ]
